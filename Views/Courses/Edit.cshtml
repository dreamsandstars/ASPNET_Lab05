@model AspNetWeek3.Mvc.ViewModels.CourseEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa khóa học";
}

<div style="max-width: 800px; margin: 0 auto; padding: 0 10px;">
    <div class="page-header-container" style="margin-bottom: 12px; margin-top: 5px;">
        <a asp-action="Index" style="color: var(--sb-green); font-weight: 700; font-size: 13.5px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none; margin-bottom: 6px;">
            &larr; Quay lại danh sách
        </a>
        <h1 class="page-title" style="font-size: 20px !important; margin: 0 0 2px 0 !important; line-height: 1.2;">Chỉnh Sửa Khóa Học</h1>
        <p class="page-description" style="margin: 0 !important; font-size: 13px !important; line-height: 1.2;">Cập nhật thông tin chi tiết của khóa học. Hệ thống tự động kiểm tra xung đột ghi đè.</p>
    </div>

    <div class="sb-card" style="padding: 16px !important;">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" style="display: flex; flex-direction: column; gap: 12px;">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RowVersion" />

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" style="margin-bottom: 0;"></div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <!-- Left Column -->
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 0 !important;">
                        <label asp-for="Name" style="font-weight: 700; font-size: 13px; color: var(--sb-dark-green); margin-bottom: 2px;">Tên khóa học</label>
                        <input asp-for="Name" class="form-control" style="height: 38px; font-size: 13.5px; padding: 6px 12px;" placeholder="Nhập tên khóa học (ví dụ: Lập trình ASP.NET Core MVC)" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size: 11.5px; margin-top: 1px;"></span>
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 0 !important;">
                        <label asp-for="CourseCategoryId" style="font-weight: 700; font-size: 13px; color: var(--sb-dark-green); margin-bottom: 2px;">Danh mục khóa học</label>
                        <select asp-for="CourseCategoryId" class="form-control" style="height: 38px; font-size: 13.5px; padding: 6px 24px 6px 10px !important; background: #ffffff;">
                            <option value="">-- Chọn danh mục khóa học --</option>
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CourseCategoryId" class="text-danger" style="font-size: 11.5px; margin-top: 1px;"></span>
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 0 !important;">
                        <label asp-for="Price" style="font-weight: 700; font-size: 13px; color: var(--sb-dark-green); margin-bottom: 2px;">Học phí (VND)</label>
                        <input asp-for="Price" type="number" step="any" value="@Model.Price.ToString("G0")" class="form-control" style="height: 38px; font-size: 13.5px; padding: 6px 12px;" placeholder="Từ 0 đến 50M" />
                        <span asp-validation-for="Price" class="text-danger" style="font-size: 11.5px; margin-top: 1px;"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <div class="form-group" style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 0 !important;">
                        <label asp-for="CourseCode" style="font-weight: 700; font-size: 13px; color: var(--sb-dark-green); margin-bottom: 2px;">Mã khóa học</label>
                        <input asp-for="CourseCode" class="form-control" style="font-family: var(--font-mono); height: 38px; font-size: 13.5px; padding: 6px 12px;" placeholder="Ví dụ: ASP-MVC" />
                        <span style="font-size: 11px; color: var(--text-muted); margin-top: 1px; display: block; line-height: 1.2;">Mã khóa học chỉ bao gồm chữ in hoa, chữ số và dấu gạch ngang (-).</span>
                        <span asp-validation-for="CourseCode" class="text-danger" style="font-size: 11.5px; margin-top: 1px;"></span>
                    </div>

                    <div class="form-group" style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 0 !important;">
                        <label asp-for="AvailableSeats" style="font-weight: 700; font-size: 13px; color: var(--sb-dark-green); margin-bottom: 2px;">Số chỗ trống</label>
                        <input asp-for="AvailableSeats" type="number" class="form-control" style="height: 38px; font-size: 13.5px; padding: 6px 12px;" placeholder="Từ 1 đến 1.000" />
                        <span asp-validation-for="AvailableSeats" class="text-danger" style="font-size: 11.5px; margin-top: 1px;"></span>
                    </div>
                </div>
            </div>

            <!-- Full Width Description -->
            <div class="form-group" style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 0 !important;">
                <label asp-for="Description" style="font-weight: 700; font-size: 13px; color: var(--sb-dark-green); margin-bottom: 2px;">Mô tả chi tiết</label>
                <textarea asp-for="Description" rows="2" class="form-control" style="resize: none; min-height: 58px; font-size: 13.5px; padding: 6px 12px;" placeholder="Nhập mô tả chi tiết về khóa học..."></textarea>
                <span asp-validation-for="Description" class="text-danger" style="font-size: 11.5px; margin-top: 1px;"></span>
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 4px; border-top: 1px solid var(--sb-ceramic); padding-top: 12px;">
                <a asp-action="Index" class="btn btn-light" style="height: 36px; display: inline-flex; align-items: center; justify-content: center; text-decoration: none; padding: 0 16px; font-size: 13px;">
                    Hủy bỏ
                </a>
                <button type="submit" class="btn" style="height: 36px; padding: 0 16px; font-size: 13px; background: var(--color-warning) !important; border-color: var(--color-warning) !important;">
                    Cập nhật khóa học
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
