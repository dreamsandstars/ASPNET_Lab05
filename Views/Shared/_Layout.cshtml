@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini Training Center</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-content" style="max-width: 96% !important; padding-left: 10px !important; padding-right: 10px !important;">
            <div class="brand" style="flex-shrink: 0;">
                <a asp-controller="Home" asp-action="Index" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--sb-white); font-weight: 800; white-space: nowrap !important;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 20px; height: 20px; color: var(--sb-gold); flex-shrink: 0;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M12 2.25V4.5m0 12.75V21.75" />
                    </svg>
                    Training Center
                </a>
            </div>

            <nav class="main-nav" style="gap: 5px !important; display: flex; align-items: center; flex-wrap: nowrap !important; overflow: hidden;">
                <style>
                    .main-nav a {
                        padding: 6px 10px !important;
                        font-size: 13px !important;
                        white-space: nowrap !important;
                    }
                </style>
                <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" && currentAction == "Index" ? "active" : "")">Dashboard</a>
                <a asp-controller="Courses" asp-action="Index" class="@(currentController == "Courses" && currentAction == "Index" ? "active" : "")">Khóa học</a>
                <a asp-controller="Courses" asp-action="Create" class="@(currentController == "Courses" && currentAction == "Create" ? "active" : "")">Thêm khóa học</a>
                <a asp-controller="Courses" asp-action="Trash" class="@(currentController == "Courses" && currentAction == "Trash" ? "active" : "")">Lưu trữ</a>
                <a asp-controller="CourseCategories" asp-action="Index" class="@(currentController == "CourseCategories" ? "active" : "")">Danh mục</a>
                <a asp-controller="Enrollments" asp-action="Create" class="@(currentController == "Enrollments" && currentAction == "Create" ? "active" : "")">Đăng ký</a>
                <a asp-controller="Enrollments" asp-action="History" class="@(currentController == "Enrollments" && currentAction == "History" ? "active" : "")">Lịch sử</a>
                <a asp-controller="AuditLogs" asp-action="Index" class="@(currentController == "AuditLogs" ? "active" : "")">Audit Logs</a>
                <a asp-controller="DataHealth" asp-action="Index" class="@(currentController == "DataHealth" ? "active" : "")">Health</a>
                <a href="/api/courses/9999">API Error</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>&copy; 2026 - Mini Training Center - Elevated Course Management System</span>
            <a href="mailto:support@trainingcenter.edu.vn">support@trainingcenter.edu.vn</a>
        </div>
    </footer>

    <!-- Frap Floating Order/Enroll CTA -->
    <a asp-controller="Enrollments" asp-action="Create" class="frap-btn" title="Quick Enroll Student">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 24px; height: 24px;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
