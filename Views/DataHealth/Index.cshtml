@model AspNetWeek3.Mvc.ViewModels.DataHealthViewModel

@{
    ViewData["Title"] = "Data Health Diagnostics";
}

<style>
    /* Grid layout */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
        margin-top: 15px;
    }

    /* Double Bezel Outer Shell for Metric Card */
    .metric-shell {
        background: rgba(0, 0, 0, 0.015);
        padding: 4px;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.03);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .metric-shell:hover {
        transform: translateY(-2px);
        background: rgba(0, 117, 74, 0.02);
        border-color: rgba(0, 117, 74, 0.1);
    }
    /* Inner Core for Metric Card */
    .metric-core {
        background: #ffffff;
        border-radius: 12px;
        padding: 16px 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 1px solid rgba(0, 0, 0, 0.04);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.015);
        min-height: 110px;
        box-sizing: border-box;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .metric-shell:hover .metric-core {
        border-color: rgba(0, 117, 74, 0.15);
        box-shadow: 0 6px 16px rgba(0, 117, 74, 0.05);
    }

    .metric-icon-wrapper {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 117, 74, 0.05);
        color: var(--sb-green);
        margin-bottom: 8px;
    }

    .metric-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 4px;
    }
    .metric-val {
        font-size: 26px;
        font-weight: 800;
        color: var(--sb-dark-green);
        line-height: 1.1;
        letter-spacing: -0.02em;
    }

    /* Diagnostics Detail Panels - Double Bezel */
    .diagnostic-panel-shell {
        background: rgba(0, 0, 0, 0.015);
        padding: 6px;
        border-radius: 20px;
        border: 1px solid rgba(0, 0, 0, 0.03);
    }
    .diagnostic-panel-core {
        background: #ffffff;
        border-radius: 14px;
        padding: 24px !important;
        border: 1px solid rgba(0, 0, 0, 0.045);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.01);
        height: 100%;
        box-sizing: border-box;
    }

    /* Status Bullets */
    .status-pulse {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--sb-green);
        box-shadow: 0 0 8px var(--sb-green);
        animation: statusPulseAnimation 1.5s infinite;
    }
    .status-text-online {
        font-size: 13.5px;
        font-weight: 800;
        color: var(--sb-green);
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    @@keyframes statusPulseAnimation {
        0% {
            transform: scale(1);
            opacity: 1;
        }
        50% {
            transform: scale(1.3);
            opacity: 0.5;
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="page-header-container" style="margin-bottom: 12px; margin-top: 5px;">
    <span class="eyebrow-tag" style="background: rgba(0, 117, 74, 0.08); color: var(--sb-dark-green); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; padding: 4px 10px; border-radius: 20px; display: inline-block; margin-bottom: 8px;">SYSTEM DIAGNOSTICS</span>
    <h1 class="page-title" style="font-size: 22px !important; margin: 0 0 2px 0 !important; line-height: 1.2; font-weight: 800; letter-spacing: -0.01em;">Trạng Thái Hệ Thống</h1>
    <p class="page-description" style="margin: 0 !important; font-size: 13.5px !important; line-height: 1.2; color: var(--text-muted);">Giám sát các chỉ số kết nối cơ sở dữ liệu vật lý, phiên bản schema và tổng số bản ghi hiện tại.</p>
</div>

<div class="metrics-grid">
    <!-- Database Status Card -->
    <div class="metric-shell">
        <div class="metric-core">
            <div class="metric-icon-wrapper" style="background: @(Model.IsDatabaseOnline ? "rgba(0, 117, 74, 0.06)" : "rgba(220, 53, 69, 0.06)"); color: @(Model.IsDatabaseOnline ? "var(--sb-green)" : "var(--color-danger)");">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 14px; height: 14px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z" />
                </svg>
            </div>
            <span class="metric-title">DATABASE STATUS</span>
            @if (Model.IsDatabaseOnline)
            {
                <span class="status-text-online">
                    <span class="status-pulse"></span>
                    ONLINE
                </span>
            }
            else
            {
                <span class="status-text-online" style="color: var(--color-danger);">
                    <span class="status-pulse" style="background: var(--color-danger); box-shadow: 0 0 8px var(--color-danger);"></span>
                    OFFLINE
                </span>
            }
        </div>
    </div>

    <!-- Categories Count Card -->
    <div class="metric-shell">
        <div class="metric-core">
            <div class="metric-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" style="width: 14px; height: 14px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
                </svg>
            </div>
            <span class="metric-title">CHUYÊN NGÀNH</span>
            <span class="metric-val">@Model.CategoryCount</span>
        </div>
    </div>

    <!-- Courses Count Card -->
    <div class="metric-shell">
        <div class="metric-core">
            <div class="metric-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" style="width: 14px; height: 14px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
            <span class="metric-title">KHÓA HỌC</span>
            <span class="metric-val">@Model.CourseCount</span>
        </div>
    </div>

    <!-- Students Count Card -->
    <div class="metric-shell">
        <div class="metric-core">
            <div class="metric-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" style="width: 14px; height: 14px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766v-.07c0-2.977 2.633-5.063 5.485-5.063a9.048 9.048 0 0 1 6.515 2.97M15 8.978a3.375 3.375 0 0 0 3-3.37c0-.985-.42-1.873-1.09-2.502M15 8.978a3.368 3.368 0 0 1-2.508 1.043 3.378 3.378 0 0 1-2.5-1.043M15 8.978a3.378 3.378 0 0 0 2.508-1.043M15 8.978v.069a3.37 3.37 0 0 0-2.508-1.043c-.886 0-1.7.343-2.31 1.043M12.492 8.978a3.378 3.378 0 0 1-2.5-1.043m-2.742 2.086a3.375 3.375 0 0 0 6.008 0M10.992 5.608a3.378 3.378 0 0 0-2.5-1.043 3.375 3.375 0 0 0-3.375 3.375c0 .985.42 1.873 1.09 2.502" />
                </svg>
            </div>
            <span class="metric-title">HỌC VIÊN</span>
            <span class="metric-val">@Model.StudentCount</span>
        </div>
    </div>

    <!-- Enrollments Count Card -->
    <div class="metric-shell">
        <div class="metric-core">
            <div class="metric-icon-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" style="width: 14px; height: 14px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664v.75h6v-.75c0-.232-.035-.454-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15a2.251 2.251 0 0 1 2.15 1.586m-5.8 0c-.065.21-.1.433-.1.664v.75h-6V4.5c0-.232.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 0 0-9-9Z" />
                </svg>
            </div>
            <span class="metric-title">PHIẾU ĐĂNG KÝ</span>
            <span class="metric-val">@Model.EnrollmentCount</span>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 24px;">
    <!-- Connection Info Panel -->
    <div class="diagnostic-panel-shell">
        <div class="diagnostic-panel-core">
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1.5px solid rgba(0, 117, 74, 0.1); padding-bottom: 10px; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 3.5px; height: 16px; background: var(--sb-green); border-radius: 20px;"></div>
                    <h3 style="font-size: 16px; font-weight: 800; color: var(--sb-dark-green); margin: 0; letter-spacing: -0.01em; display: flex; align-items: center; gap: 6px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-.778.099-1.533.284-2.253" />
                        </svg>
                        Thông Tin Kết Nối
                    </h3>
                </div>
            </div>

            <div style="margin-bottom: 18px;">
                <label style="font-size: 11px; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Provider CSDL</label>
                <span style="font-family: var(--font-mono); font-size: 13px; font-weight: 700; color: var(--sb-dark-green); background: rgba(0, 117, 74, 0.05); border: 1px solid rgba(0, 117, 74, 0.1); padding: 5px 10px; border-radius: 6px; display: inline-block;">
                    @Model.DatabaseProvider
                </span>
            </div>
            
            <div>
                <label style="font-size: 11px; color: var(--text-muted); font-weight: 700; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Chuỗi Kết Nối (Connection String)</label>
                <code style="font-family: var(--font-mono); font-size: 12px; color: #334155; word-break: break-all; background: rgba(0, 0, 0, 0.015); padding: 12px; border-radius: 8px; display: block; line-height: 1.5; border: 1px solid rgba(0, 0, 0, 0.045);">
                    @Model.ConnectionString
                </code>
            </div>
        </div>
    </div>

    <!-- EF Core Migrations Panel -->
    <div class="diagnostic-panel-shell">
        <div class="diagnostic-panel-core">
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1.5px solid rgba(0, 117, 74, 0.1); padding-bottom: 10px; margin-bottom: 16px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 3.5px; height: 16px; background: var(--sb-green); border-radius: 20px;"></div>
                    <h3 style="font-size: 16px; font-weight: 800; color: var(--sb-dark-green); margin: 0; letter-spacing: -0.01em; display: flex; align-items: center; gap: 6px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 18px; height: 18px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.59 5.83a14.98 14.98 0 0 0-6.16 12.12A14.98 14.98 0 0 0 15.59 14.37ZM15.59 14.37a14.98 14.98 0 0 1-6.16 12.12A14.98 14.98 0 0 1 3.25 18M18.8 8.44A14.98 14.98 0 0 0 9.59 5.83M12.98 11.2a1 1 0 1 0-1.99 0v4.8M10.99 16a1 1 0 1 0 1.99 0" />
                        </svg>
                        Lịch Sử Migration EF Core
                    </h3>
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="font-size: 11px; color: var(--sb-green); font-weight: 700; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Migrations Đã Chạy (@Model.AppliedMigrations.Count)</label>
                @if (!Model.AppliedMigrations.Any())
                {
                    <span style="font-size: 13px; color: var(--text-muted); font-style: italic;">Chưa áp dụng migration nào.</span>
                }
                else
                {
                    <div style="background: var(--sb-dark-green); border-radius: 8px; padding: 12px 16px; border: 1px solid rgba(0,0,0,0.05); max-height: 100px; overflow-y: auto;">
                        <ul style="margin: 0; padding: 0; font-family: var(--font-mono); font-size: 11.5px; color: var(--sb-mint); line-height: 1.5; list-style: none;">
                            @foreach (var migration in Model.AppliedMigrations)
                            {
                                <li style="display: flex; align-items: center; gap: 6px;">
                                    <span style="color: #22c55e;">✔</span> @migration
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <div>
                <label style="font-size: 11px; color: @(Model.PendingMigrations.Any() ? "var(--color-warning)" : "var(--text-muted)"); font-weight: 700; display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Migrations Đang Chờ (@Model.PendingMigrations.Count)</label>
                @if (!Model.PendingMigrations.Any())
                {
                    <div style="background: rgba(0, 117, 74, 0.05); border: 1px solid rgba(0, 117, 74, 0.12); color: var(--sb-green); border-radius: 8px; padding: 10px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; width: 100%; box-sizing: border-box;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" style="width: 14px; height: 14px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                        </svg>
                        Cơ sở dữ liệu hoàn toàn khớp cấu trúc.
                    </div>
                }
                else
                {
                    <div style="background: rgba(217, 119, 6, 0.05); border: 1px solid rgba(217, 119, 6, 0.15); border-radius: 8px; padding: 12px 16px;">
                        <ul style="margin: 0; padding: 0; font-family: var(--font-mono); font-size: 11.5px; color: #d97706; line-height: 1.5; list-style: none;">
                            @foreach (var migration in Model.PendingMigrations)
                            {
                                <li style="display: flex; align-items: center; gap: 6px;">
                                    <span>⚠</span> @migration
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
