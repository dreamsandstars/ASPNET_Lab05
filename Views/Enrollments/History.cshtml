@model IEnumerable<AspNetWeek3.Mvc.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollment History";
}

<div class="page-header-container" style="margin-bottom: 35px; margin-top: 10px;">
    <h1 class="page-title">Enrollment Ledger</h1>
    <p class="page-description">Historical log of verified registrations (queried efficiently using AsNoTracking + Include joins)</p>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>TXN ID</th>
                <th>Timestamp</th>
                <th>Student Account</th>
                <th>Course Offerings</th>
                <th style="text-align: center;">Seats</th>
                <th style="text-align: right;">Total Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" style="padding: 60px !important; text-align: center; color: var(--text-muted); font-size: 15px;">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 44px; height: 44px; margin: 0 auto 16px auto; color: var(--text-muted); opacity: 0.5;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                        </svg>
                        No enrollment transactions recorded yet.
                    </td>
                </tr>
            }
            else
            {
                foreach (var enroll in Model)
                {
                    <tr>
                        <td style="font-weight: 700; color: var(--sb-green); font-family: var(--font-mono); font-size: 13.5px; padding: 18px 20px !important;">
                            #ENR-@enroll.Id.ToString("D4")
                        </td>
                        <td style="color: var(--text-muted); font-size: 14px; padding: 18px 20px !important;">
                            @enroll.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td style="padding: 18px 20px !important;">
                            <div style="font-weight: 700; color: var(--sb-dark-green);">@enroll.Student?.Name</div>
                            <div style="font-size: 12.5px; color: var(--text-muted); margin-top: 2px;">@enroll.Student?.Email</div>
                        </td>
                        <td style="padding: 18px 20px !important;">
                            @foreach (var detail in enroll.EnrollmentDetails)
                            {
                                <div style="font-weight: 600; color: var(--text-body);">
                                    @detail.Course?.Name
                                </div>
                                <div style="font-size: 12px; color: var(--text-muted); margin-top: 1px;">
                                    Unit Price: @detail.UnitPrice.ToString("N0") VND
                                </div>
                            }
                        </td>
                        <td style="padding: 18px 20px !important; text-align: center; font-weight: 700; color: var(--text-body);">
                            @enroll.EnrollmentDetails.Sum(d => d.Quantity)
                        </td>
                        <td style="padding: 18px 20px !important; text-align: right; font-family: var(--font-serif); font-weight: 800; color: var(--sb-green); font-size: 16px;">
                            @enroll.TotalAmount.ToString("N0") <span style="font-family: var(--font-sans); font-size: 12px; font-weight: 500; color: var(--text-muted);">VND</span>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
