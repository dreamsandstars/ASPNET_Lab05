@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-header-container" style="margin-bottom: 24px;">
    <h1 class="page-title">Privacy Policy</h1>
    <p class="page-description">How we manage and secure student credentials and records at Mini Training Center.</p>
</div>

<div class="sb-card" style="max-width: 750px;">
    <h3 class="coffee-title" style="margin-bottom: 12px; font-weight: 800;">1. Information Collection</h3>
    <p style="margin-bottom: 20px; color: var(--text-body);">We only collect essential details (Name, Email, Enrollment Data) required to register students into training programs and classes.</p>

    <h3 class="coffee-title" style="margin-bottom: 12px; font-weight: 800;">2. Data Safety</h3>
    <p style="margin-bottom: 20px; color: var(--text-body);">All database transactions are securely logged using Serilog. Access is restricted to training coordinators and instructors only.</p>

    <h3 class="coffee-title" style="margin-bottom: 12px; font-weight: 800;">3. Contact</h3>
    <p style="color: var(--text-body);">If you have any questions, reach out to us at <a href="mailto:privacy@trainingcenter.edu.vn" style="color: var(--sb-green); font-weight: 700;">privacy@trainingcenter.edu.vn</a>.</p>
</div>
