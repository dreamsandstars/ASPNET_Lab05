@{
    ViewData["Title"] = "Không tìm thấy trang - 404";
}

<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center;">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 80px; height: 80px; color: var(--sb-green); margin-bottom: 20px; animation: float 3s ease-in-out infinite;">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v2.418M12 3.104v2.418M14.25 3.104v2.418M4.25 8.25h13.5a2.25 2.25 0 0 1 2.25 2.25v2.25a2.25 2.25 0 0 1-2.25 2.25h-13.5A2.25 2.25 0 0 1 2 12.75v-2.25A2.25 2.25 0 0 1 4.25 8.25Zm13.5 0h.75a3.75 3.75 0 0 1 3.75 3.75v0a3.75 3.75 0 0 1-3.75 3.75h-.75V8.25Zm-13.5 6.75h13.5v6.75a3.75 3.75 0 0 1-3.75 3.75h-6a3.75 3.75 0 0 1-3.75-3.75V15Z" />
    </svg>
    
    <h1 class="page-title" style="margin-bottom: 10px;">404 - Không tìm thấy trang</h1>
    
    <p class="page-description" style="max-width: 500px; margin-bottom: 30px;">
        Đường dẫn bạn truy cập không tồn tại hoặc đã được thay đổi. Vui lòng quay lại Trang chủ hoặc danh sách Khóa học.
    </p>

    <div style="display: flex; gap: 12px; justify-content: center;">
        <a class="btn" asp-controller="Home" asp-action="Index">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px; margin-right: 6px;">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            Về Trang Chủ
        </a>
        <a class="btn btn-secondary" asp-controller="Courses" asp-action="Index">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width: 16px; height: 16px; margin-right: 6px;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
            </svg>
            Danh Sách Khóa Học
        </a>
    </div>
</div>

<style>
    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
</style>
